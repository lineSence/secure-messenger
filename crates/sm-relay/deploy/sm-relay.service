# systemd-юнит узла (relay.md). Перед запуском: swap выключен (swapoff -a, убрать из /etc/fstab).
[Unit]
Description=sm-relay (очереди зашифрованных блобов в памяти)
After=network.target

[Service]
Environment=SM_RELAY_LISTEN=127.0.0.1:7400
# Приём HTTP/1.1 от обратного прокси (nginx или Caddy, ADR-90); без этой строки — кадры прямо по TCP.
Environment=SM_RELAY_MODE=http
ExecStart=/usr/local/bin/sm-relay
# Постоянный ключ гостевых пропусков (ADR-146): файл из 64 HEX-знаков, права 0600, владелец root
# (создание — relay-deploy.md). Узел читает его из каталога учётных данных systemd
# ($CREDENTIALS_DIRECTORY/guest-key); без файла юнит не запустится. Ключ нужен, чтобы гостевые
# пропуска переживали перезапуск узла; при смене ключа все гостевые пропуска перестают работать.
LoadCredential=guest-key:/etc/sm-relay/guest.key
DynamicUser=yes
# Логов нет: ни stdout, ни stderr не сохраняются.
StandardOutput=null
StandardError=null
# Core-дамп записал бы память с очередями на диск.
LimitCORE=0
# Блобы не должны попадать в swap, даже если он включён.
MemorySwapMax=0
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# /dev/urandom доступен и при PrivateDevices=yes.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
MemoryMax=512M
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
